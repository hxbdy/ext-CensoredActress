{
  "manifest_version": 3,
  "name": "DMM Cast Auto-Filler",
  "version": "1.3",
  "description": "FANZA動画の作品ページで、空欄の出演者欄をav-wikiの情報で補完します。一覧ページではBEST・ベスト作品を非表示にできます。",
  "icons": {
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://video.dmm.co.jp/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://video.dmm.co.jp/*",
    "https://av-wiki.net/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{b4649f68-c6c7-4dcf-81b8-b2d3561b585a}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["browsingActivity"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
