{
  "manifest_version": 3,
  "name": "DMM Cast Auto-Filler",
  "version": "1.2",
  "description": "FANZA動画の作品ページで、空欄の出演者欄をav-wikiの情報で補完します。一覧ページではBEST・ベスト作品を非表示にできます。",
  "icons": {
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://video.dmm.co.jp/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://video.dmm.co.jp/*",
    "https://av-wiki.net/*"
  ]
}
